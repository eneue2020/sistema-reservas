# Copia este archivo como .env y ajusta los valores.

# --- Servidor ---
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=data/bookings.db

# --- Profesional y servicio ---
PROFESSIONAL_NAME=Ivan AlsiGo
# URL opcional de una foto; si queda vacío se muestran las iniciales.
PROFESSIONAL_AVATAR_URL=
SERVICE_NAME=Asesoría IA
SERVICE_DESCRIPTION=Sesión individual para analizar tu caso y descubrir cómo aplicar la inteligencia artificial en tu negocio o proyecto.
SERVICE_DURATION_MINUTES=30
SERVICE_LOCATION=Google Meet

# --- Disponibilidad ---
# Zona horaria del profesional (nombres IANA).
TIMEZONE=America/Argentina/Buenos_Aires
# Días laborables: 1=lunes … 7=domingo
WORK_DAYS=1,2,3,4,5
# Bloques horarios separados por comas (hora local del profesional)
WORK_HOURS=09:00-13:00,14:00-18:00
# Cada cuántos minutos empieza un horario
SLOT_INTERVAL_MINUTES=30
# Antelación mínima para reservar (horas)
MIN_NOTICE_HOURS=2
# Hasta cuántos días en el futuro se puede reservar
BOOKING_WINDOW_DAYS=60
# Días sin atención (feriados, vacaciones), formato AAAA-MM-DD separados por comas
BLOCKED_DATES=

# --- Google Calendar ---
# Pon true cuando tengas las tres credenciales (ver README).
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Lo genera automáticamente: python scripts/google_auth.py
GOOGLE_REFRESH_TOKEN=
# Dirección de vuelta para scripts/google_auth.py. Debe figurar tal cual en
# "URIs de redireccionamiento autorizados" del cliente OAuth en Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:8085/
# "primary" = calendario principal de la cuenta autorizada
GOOGLE_CALENDAR_ID=primary
